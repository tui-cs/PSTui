<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Canonical source for a community (tui-cs) project. Replaces the
         Microsoft OneBranch CFS mirror, which lagged newer Terminal.Gui
         releases (e.g. 2.4.10 was unavailable there). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- TEMP: local feed for the vendored Terminal.Gui 2.5.0 preview built from
         tui-cs/Terminal.Gui#5416. Remove (along with ./local_packages) once
         2.5.x is published to nuget.org. -->
    <add key="tgui-pr-5416" value="./local_packages" />
  </packageSources>
</configuration>
